####### Compile

release/main.o: ../main.cpp ../mainwindow.h \
		../cardbmanager.h \
		../parkingstore.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\main.o ..\main.cpp

release/mainwindow.o: ../mainwindow.cpp ../mainwindow.h \
		../cardbmanager.h \
		../parkingstore.h \
		ui_mainwindow.h \
		../camerathread.h \
		../entrydialog.h \
		../exitdialog.h \
		../loadingdialog.h \
		../serialcontroller.h \
		../vehiclelistdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\mainwindow.o ..\mainwindow.cpp

release/loadingdialog.o: ../loadingdialog.cpp ../loadingdialog.h \
		ui_loadingdialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\loadingdialog.o ..\loadingdialog.cpp

release/entrydialog.o: ../entrydialog.cpp ../entrydialog.h \
		ui_entrydialog.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\entrydialog.o ..\entrydialog.cpp

